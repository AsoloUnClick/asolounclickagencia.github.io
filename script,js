document.addEventListener(
"DOMContentLoaded",
function () {


/* ==================================================
BANNERS
================================================== */

const hero =
document.querySelector(".hero");


if (hero) {

setInterval(
function () {

hero.classList.toggle("alt");

},
6500
);

}



/* ==================================================
INTERFAZ ENJAMBRE
================================================== */

const interfaceCards =
document.querySelectorAll(
".interface-card"
);


if ("IntersectionObserver" in window) {

const interfaceObserver =
new IntersectionObserver(

function (entries) {

entries.forEach(
function (entry) {

if (entry.isIntersecting) {

entry.target
.classList
.add("visible");

interfaceObserver
.unobserve(
entry.target
);

}

}
);

},

{
threshold:0.12,
rootMargin:"0px 0px -5% 0px"
}

);


interfaceCards.forEach(
function (card) {

interfaceObserver.observe(card);

}
);

}

else {

interfaceCards.forEach(
function (card) {

card.classList.add("visible");

}
);

}



/* ==================================================
VIDEOS

Todos:
- autoplay
- muted
- loop
- playsinline

Al tocar:
- activa sonido
- los demás quedan silenciados
- ninguno se detiene
================================================== */

const videoCards =
document.querySelectorAll(
".video-card"
);


videoCards.forEach(
function (card) {


const video =
card.querySelector("video");


const hint =
card.querySelector(".sound-hint");


if (!video) {
return;
}


video.muted = true;

video.loop = true;

video.playsInline = true;


/* AUTOPLAY */

const playPromise =
video.play();


if (playPromise !== undefined) {

playPromise.catch(
function () {}
);

}



/* TOCAR VIDEO */

card.addEventListener(
"click",
function () {


const activarSonido =
video.muted;


/* SILENCIAR LOS OTROS */

videoCards.forEach(
function (otherCard) {


const otherVideo =
otherCard.querySelector(
"video"
);


const otherHint =
otherCard.querySelector(
".sound-hint"
);


if (
otherVideo &&
otherVideo !== video
) {


otherVideo.muted = true;


otherCard.classList.remove(
"audio-active"
);


if (otherHint) {

otherHint.innerHTML =
'<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

}

}

}
);


/* ACTIVAR / DESACTIVAR */

video.muted =
!activarSonido;


if (activarSonido) {


card.classList.add(
"audio-active"
);


if (hint) {

hint.innerHTML =
'<i class="fa-solid fa-volume-high"></i> SONIDO ACTIVADO';

}


}

else {


card.classList.remove(
"audio-active"
);


if (hint) {

hint.innerHTML =
'<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

}

}


/* ASEGURAR REPRODUCCIÓN */

if (video.paused) {

video.play().catch(
function () {}
);

}

}
);

});



/* ==================================================
CUANDO SE CAMBIA DE PESTAÑA
================================================== */

document.addEventListener(
"visibilitychange",
function () {


if (document.hidden) {


videoCards.forEach(
function (card) {


const video =
card.querySelector(
"video"
);


const hint =
card.querySelector(
".sound-hint"
);


if (video) {

video.muted = true;

}


card.classList.remove(
"audio-active"
);


if (hint) {

hint.innerHTML =
'<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

}

}
);

}

}
);


}
);
