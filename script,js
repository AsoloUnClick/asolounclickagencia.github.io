/* ==========================================================
   A SOLO UNCLICK
   SCRIPT.JS — VERSIÓN COMPLETA
========================================================== */

document.addEventListener("DOMContentLoaded", function () {


  /* ========================================================
     HERO
     CAMBIO AUTOMÁTICO ENTRE BANNER 1 Y BANNER 2
  ======================================================== */

  const hero = document.querySelector(".hero");

  if (hero) {

    let bannerInterval = setInterval(function () {

      hero.classList.toggle("alt");

    }, 6500);


    /* Evitar que el intervalo quede ejecutándose
       innecesariamente si la página cambia */

    document.addEventListener("visibilitychange", function () {

      if (document.hidden) {

        clearInterval(bannerInterval);

      } else {

        bannerInterval = setInterval(function () {

          hero.classList.toggle("alt");

        }, 6500);

      }

    });

  }


  /* ========================================================
     INTERFAZ
     EFECTO ENJAMBRE / CARDUMEN
     
     Las 5 imágenes:
     
     pantallazointerfaz1.jpeg
     pantallazointerfaz2.jpeg
     pantallazointerfaz3.jpeg
     pantallazointerfaz4.jpeg
     pantallazointerfaz5.jpeg
     
     aparecen progresivamente al hacer scroll.
  ======================================================== */

  const interfaceCards =
    document.querySelectorAll(".interface-card");


  if (
    "IntersectionObserver" in window
  ) {

    const interfaceObserver =
      new IntersectionObserver(

        function (entries) {

          entries.forEach(function (entry) {

            if (
              entry.isIntersecting
            ) {

              entry.target
                .classList
                .add("visible");


              interfaceObserver
                .unobserve(
                  entry.target
                );

            }

          });

        },

        {
          threshold: 0.10,

          rootMargin:
            "0px 0px -8% 0px"
        }

      );


    interfaceCards.forEach(function (card) {

      interfaceObserver.observe(card);

    });

  }

  else {

    interfaceCards.forEach(function (card) {

      card.classList.add("visible");

    });

  }


  /* ========================================================
     TESTIMONIOS
     
     ARCHIVOS UTILIZADOS:
     
     testimonio fernando chile.mp4
     testimonio gini transporta quiliana 3.mp4
     testimonio mudanzas los mendez.mp4
     testimonio pablo pinzón colombia.mp4
     
     Comportamiento:
     
     - autoplay
     - muted
     - loop
     - playsinline
     - tocar = activar sonido
     - tocar otro = silenciar el anterior
     - ningún video se detiene por escuchar otro
  ======================================================== */

  const videoCards =
    document.querySelectorAll(".video-card");


  videoCards.forEach(function (card) {

    const video =
      card.querySelector("video");

    const hint =
      card.querySelector(".sound-hint");


    if (!video) {
      return;
    }


    /* ------------------------------------------------------
       CONFIGURACIÓN INICIAL
    ------------------------------------------------------ */

    video.muted = true;

    video.defaultMuted = true;

    video.loop = true;

    video.playsInline = true;

    video.setAttribute(
      "playsinline",
      ""
    );

    video.setAttribute(
      "webkit-playsinline",
      ""
    );

    video.setAttribute(
      "loop",
      ""
    );

    video.setAttribute(
      "muted",
      ""
    );


    /* ------------------------------------------------------
       INTENTAR AUTOPLAY
    ------------------------------------------------------ */

    const initialPlay =
      video.play();


    if (
      initialPlay !== undefined
    ) {

      initialPlay.catch(function () {

        /*

        Algunos navegadores,
        especialmente móviles,
        pueden bloquear autoplay.

        No hacemos nada aquí.
        El usuario podrá tocar el video.

        */

      });

    }


    /* ------------------------------------------------------
       ASEGURAR LOOP
    ------------------------------------------------------ */

    video.addEventListener(
      "ended",
      function () {

        if (video.loop) {

          video.currentTime = 0;

          video.play().catch(
            function () {}
          );

        }

      }
    );


    /* ------------------------------------------------------
       TOCAR EL VIDEO
    ------------------------------------------------------ */

    card.addEventListener(
      "click",
      function () {


        /*
          Determinamos si estamos pasando
          de silencio a sonido.
        */

        const activateSound =
          video.muted;


        /* --------------------------------------------------
           SILENCIAR TODOS LOS DEMÁS
        -------------------------------------------------- */

        videoCards.forEach(
          function (otherCard) {

            const otherVideo =
              otherCard.querySelector(
                "video"
              );

            const otherHint =
              otherCard.querySelector(
                ".sound-hint"
              );


            if (
              otherVideo &&
              otherVideo !== video
            ) {

              /*
                Importante:
                NO pausamos el otro video.
                Solo lo silenciamos.
              */

              otherVideo.muted = true;


              otherCard
                .classList
                .remove(
                  "audio-active"
                );


              if (otherHint) {

                otherHint.innerHTML =
                  '<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

              }

            }

          }
        );


        /* --------------------------------------------------
           ACTIVAR / DESACTIVAR SONIDO
        -------------------------------------------------- */

        video.muted =
          !activateSound;


        if (activateSound) {

          card
            .classList
            .add(
              "audio-active"
            );


          if (hint) {

            hint.innerHTML =
              '<i class="fa-solid fa-volume-high"></i> SONIDO ACTIVADO';

          }

        }

        else {

          card
            .classList
            .remove(
              "audio-active"
            );


          if (hint) {

            hint.innerHTML =
              '<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

          }

        }


        /* --------------------------------------------------
           SI ESTABA DETENIDO, REPRODUCIR
        -------------------------------------------------- */

        if (
          video.paused
        ) {

          video.play().catch(
            function () {}
          );

        }

      }
    );


    /* ------------------------------------------------------
       SI EL VIDEO SE PAUSA POR EL NAVEGADOR
       INTENTAMOS REANUDARLO
    ------------------------------------------------------ */

    video.addEventListener(
      "pause",
      function () {

        /*
          No forzamos inmediatamente la reproducción
          mientras la pestaña está oculta.
        */

        if (
          !document.hidden &&
          video.readyState >= 2
        ) {

          /*
            Esperamos un pequeño intervalo para
            evitar conflictos con controles del navegador.
          */

          setTimeout(function () {

            if (
              !document.hidden &&
              video.paused
            ) {

              video.play().catch(
                function () {}
              );

            }

          }, 300);

        }

      }
    );

  });


  /* ========================================================
     AL VOLVER A LA PÁGINA
     
     Reanudamos los videos.
     Todos permanecen silenciados al volver.
  ======================================================== */

  document.addEventListener(
    "visibilitychange",
    function () {


      if (
        document.hidden
      ) {

        /*
          Al salir de la página:
          silenciar todos.
        */

        videoCards.forEach(
          function (card) {

            const video =
              card.querySelector(
                "video"
              );

            const hint =
              card.querySelector(
                ".sound-hint"
              );


            if (video) {

              video.muted = true;

            }


            card
              .classList
              .remove(
                "audio-active"
              );


            if (hint) {

              hint.innerHTML =
                '<i class="fa-solid fa-volume-xmark"></i> TOCA PARA ESCUCHAR';

            }

          }
        );

      }


      else {

        /*
          Al regresar:
          intentamos continuar todos los videos.
        */

        videoCards.forEach(
          function (card) {

            const video =
              card.querySelector(
                "video"
              );


            if (video) {

              video.muted = true;


              video.play().catch(
                function () {}
              );

            }

          }
        );

      }

    }
  );


  /* ========================================================
     ENLACES DEL MENÚ
     
     Cierra cualquier comportamiento extraño al navegar
     dentro de la página.
  ======================================================== */

  const menuLinks =
    document.querySelectorAll(
      '.navbar nav a[href^="#"]'
    );


  menuLinks.forEach(
    function (link) {

      link.addEventListener(
        "click",
        function () {

          const targetId =
            link.getAttribute(
              "href"
            );

          const target =
            document.querySelector(
              targetId
            );


          if (target) {

            target.scrollIntoView({
              behavior:
                "smooth",
              block:
                "start"
            });

          }

        }
      );

    }
  );


});
